# paths
: "${GSM_ROOT:=/opt/GSM}"
: "${QEMU_TREE:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
: "${QEMU_BIN:=$QEMU_TREE/build/qemu-system-arm}"
: "${QEMU_CFGS:=$QEMU_TREE/cfgs}"
: "${FIRMWARE_DIR:=$GSM_ROOT/firmware}"
# Default layer1.highram_patched (B_BFI frames, FACCH stealing included, zero payload, masked by
# the GAPK ECU: see layer1.highram_patched.patch), fallback to layer1.highram if missing.
if [ -z "${FIRMWARE_ELF:-}" ]; then
    if [ -r "$FIRMWARE_DIR/board/compal_e88/layer1.highram_patched.elf" ]; then
        FIRMWARE_ELF="$FIRMWARE_DIR/board/compal_e88/layer1.highram_patched.elf"
    else
        FIRMWARE_ELF="$FIRMWARE_DIR/board/compal_e88/layer1.highram.elf"
    fi
fi
: "${FIRMWARE_BIN:=${FIRMWARE_ELF%.elf}.bin}"
: "${OSMOCOM_BB:=$GSM_ROOT/osmocom-bb}"
: "${OSMOCON:=$OSMOCOM_BB/src/host/osmocon/osmocon}"
: "${OSMOCOM_CFG:=/etc/osmocom}"
: "${OSMOCOM_HOME:=$HOME/.osmocom}"
: "${NITB_ROOT:=$GSM_ROOT/osmo-operator}"
# runtime and logs
: "${RUN_DIR:=${XDG_RUNTIME_DIR:-/tmp}/calypso}"
: "${LOG_DIR:=$RUN_DIR/logs}"
: "${CAPTURE_DIR:=$RUN_DIR/captures}"
: "${TMUX_SESSION:=calypso}"
# core network
: "${ENCRYPTION:=a5 0}"
# mobiles
: "${CALYPSO_MOBILE_DEBUG:=DCS:DNB:DPLMN:DRR:DMM:DSIM:DCC:DMNCC:DSS:DLSMS:DPAG:DSUM:DSAP:DGPS:DMOB:DPRIM:DLUA:DGAPK:DLLAPD}"
: "${CALYPSO_PULSE_LATENCY_MSEC:=80}"
# display
: "${CALYPSO_LANG:=en}"
: "${CALYPSO_NO_ATTACH:=0}"
# noise (off by default; run_modules/38-bruit.sh, tools/injecteur_bruit.py) -- comments
# only: nothing is set here, the caller's environment decides.
#   BRUIT_MODE=ber|souple|iq|relais   BRUIT_BER=0..1   BRUIT_RAFALES=<bits>   BRUIT_SNR_DB=<dB>
#   BRUIT_PERTE=0..1   BRUIT_TN=0,1   BRUIT_GRAINE=<n>   BRUIT_STATS=10   BRUIT_OPTS=...
#   BRUIT_SNR_DB alone = AWGN of the C54x core (CALYPSO_BSP_SNR_DB), DSP L1 only.
