# cmd.gdb — osmocom panel for gdb (generated by tools/gdb_cmd.sh, do not edit)
# Type `help_osmo` for the list. The help texts are in English, short, and read
# the symbols of the osmocom-bb firmware (layer1.highram.elf).
set pagination off
set confirm off
set print pretty on
set height 0
set width 0
set $API = 0xffd00000

# ── dsp_api / l1_environment.h constants ────────────────────────────────────
set $B_BLUD = 15
set $B_SCH_CRC = 8
set $B_FIRE0 = 5
set $B_FIRE1 = 6
set $B_TASK_ABORT = 15

# =============================================================================
#  EXECUTION
# =============================================================================
define go
  continue &
end
document go
go — resumes the target WITHOUT blocking the prompt (continue &). Ctrl-C = stop.
end

define stop
  interrupt
end
document stop
stop — stops the ARM (same as Ctrl-C). Then regs, bt10, fn, ndb...
end

define regs
  info registers
end
document regs
regs — all ARM registers (target stopped).
end

define pcx
  x/8i $pc
end
document pcx
pcx — 8 instructions from $pc.
end

define bt10
  bt 10
end
document bt10
bt10 — call stack, 10 levels.
end

define si1
  stepi
  x/1i $pc
end
document si1
si1 — one instruction, shows the next one.
end

define ni1
  nexti
  x/1i $pc
end
document ni1
ni1 — one instruction without stepping into calls.
end

define frame_step
  tbreak tdma_sched_execute
  continue
  fn
end
document frame_step
frame_step — runs until the NEXT TDMA frame (tdma_sched_execute), then stops and shows fn.
end

# =============================================================================
#  TIME / SCHEDULER
# =============================================================================
define fn
  printf "fn=%u  (t1=%u t2=%u t3=%u)   next fn=%u   tpu_offset=%u corr=%d\n", l1s.current_time.fn, l1s.current_time.t1, l1s.current_time.t2, l1s.current_time.t3, l1s.next_time.fn, l1s.tpu_offset, l1s.tpu_offset_correction
end
document fn
fn — current L1 frame number (l1s.current_time), the next one, and the TPU offset.
end

define l1
  fn
  printf "cell   : arfcn=%u bsic=%u  fn_offset=%u  time_align=%u\n", l1s.serving_cell.arfcn, l1s.serving_cell.bsic, l1s.serving_cell.fn_offset, l1s.serving_cell.time_alignment
  printf "modes  : fb.mode=%u  pm.mode=%u  dedicated.type=%d tn=%u tsc=%u h=%u\n", l1s.fb.mode, l1s.pm.mode, l1s.dedicated.type, l1s.dedicated.tn, l1s.dedicated.tsc, l1s.dedicated.h
  printf "radio  : ta=%d tx_power=%u tch_mode=%u audio=%u  compl=0x%08x\n", l1s.ta, l1s.tx_power, l1s.tch_mode, l1s.audio_mode, l1s.scheduled_compl
  pages
end
document l1
l1 — summary of the L1 state: time, serving cell, FB/PM/dedicated modes, TA, power, DSP pages.
end

define cell
  p l1s.serving_cell
end
document cell
cell — the serving cell (arfcn, bsic, fn_offset, time_alignment, rxlev...).
end

define neigh
  p l1s.neigh_cell
  printf "neigh_pm : n=%u running=%u pos=%u\n", l1s.neigh_pm.n, l1s.neigh_pm.running, l1s.neigh_pm.pos
end
document neigh
neigh — the 6 neighbours known to L1 and the state of the neighbour measurements.
end

define sched
  p l1s.tdma_sched
end
document sched
sched — the TDMA scheduler (items scheduled for the next frames).
end

define mframe
  p l1s.mframe_sched
end
document mframe
mframe — the multiframe scheduler (active BCCH/CCCH/SDCCH/TCH).
end

define compl
  printf "scheduled_compl = 0x%08x  (bit0 FB, 1 RACH, 2 TX_NB, 3 TCH, 4 TX_SB?, see l1s.completion[])\n", l1s.scheduled_compl
end
document compl
compl — mask of pending L1 completions (l1s.scheduled_compl).
end

define arfcn
  printf "rf_arfcn = %u\n", rf_arfcn
end
document arfcn
arfcn — current ARFCN of the radio front end.
end

define afc
  p afc_state
end
document afc
afc — AFC state (frequency correction loop).
end

# =============================================================================
#  FB / SB (sync) — what L1 has seen
# =============================================================================
define fbs
  p fbs
end
document fbs
fbs — full state of the FB/SB acquisition (fbs.mon: bsic, time, toa, pm, angle, snr, attempt; fbs.req).
end

define mon
  printf "mon : bsic=%u  toa=%d pm=%d angle=%d snr=%u  attempt=%d  fn_report=%u  time fn=%u\n", fbs.mon.bsic, (short)fbs.mon.toa, (short)fbs.mon.pm, (short)fbs.mon.angle, fbs.mon.snr, fbs.mon.attempt, fbs.mon.fnr_report, fbs.mon.time.fn
end
document mon
mon — the last FB/SB result as the ARM read it (fbs.mon).
end

# =============================================================================
#  MAILBOX ARM <-> DSP (dsp_api: ndb / db_r / db_w)
# =============================================================================
define pages
  printf "pages  : r_page=%d w_page=%d r_page_used=%d frame_ctr=%d   ndb.d_dsp_page=0x%04x\n", dsp_api.r_page, dsp_api.w_page, dsp_api.r_page_used, dsp_api.frame_ctr, dsp_api.ndb->d_dsp_page & 0xffff
  printf "         db_r=%p  db_w=%p  ndb=%p  param=%p\n", dsp_api.db_r, dsp_api.db_w, dsp_api.ndb, dsp_api.param
end
document pages
pages — MCU<->DSP double-buffering pages (r_page/w_page seen by the ARM, d_dsp_page seen by the DSP).
end

define err
  set $e = dsp_api.ndb->d_error_status & 0xffff
  printf "d_error_status = 0x%04x", $e
  if $e & 0x0008
    printf "  DSP_ERR_DMA_PROG"
  end
  if $e & 0x0010
    printf "  DSP_ERR_DMA_TASK"
  end
  printf "\n"
end
document err
err — DSP d_error_status, decoded (8 = DMA_PROG, 0x10 = DMA_TASK; an indicator, not a blocker).
end

define taskname
  if $arg0 == 0
    printf "-"
  end
  if $arg0 == 1
    printf "PM"
  end
  if $arg0 == 5
    printf "FB"
  end
  if $arg0 == 6
    printf "SB"
  end
  if $arg0 == 10
    printf "RACH"
  end
  if $arg0 == 19
    printf "NBS"
  end
  if $arg0 == 21
    printf "NP"
  end
  if $arg0 == 24
    printf "ALLC"
  end
  if $arg0 == 33
    printf "CHECKSUM"
  end
end

define tasks
  set $td = dsp_api.db_w->d_task_d & 0xffff
  set $tu = dsp_api.db_w->d_task_u & 0xffff
  set $tm = dsp_api.db_w->d_task_md & 0xffff
  set $tr = dsp_api.db_w->d_task_ra & 0xffff
  printf "db_w (ARM->DSP) : task_d=%u(", $td
  taskname $td
  printf ") burst_d=%u  task_u=%u(", dsp_api.db_w->d_burst_d & 0xffff, $tu
  taskname $tu
  printf ") burst_u=%u  task_md=%u(", dsp_api.db_w->d_burst_u & 0xffff, $tm
  taskname $tm
  printf ")  task_ra=%u\n", $tr
  printf "                 d_fn=0x%04x ctrl_abb=0x%04x afc=%d(0x%04x) ctrl_system=0x%04x power_ctl=0x%04x ctrl_tch=0x%04x\n", dsp_api.db_w->d_fn & 0xffff, dsp_api.db_w->d_ctrl_abb & 0xffff, (short)(dsp_api.db_w->d_afc & 0xffff), dsp_api.db_w->d_afc & 0xffff, dsp_api.db_w->d_ctrl_system & 0xffff, dsp_api.db_w->d_power_ctl & 0xffff, dsp_api.db_w->d_ctrl_tch & 0xffff
  set $rd = dsp_api.db_r->d_task_d & 0xffff
  printf "db_r (DSP->ARM) : task_d=%u(", $rd
  taskname $rd
  printf ") burst_d=%u task_u=%u burst_u=%u task_md=%u task_ra=%u\n", dsp_api.db_r->d_burst_d & 0xffff, dsp_api.db_r->d_task_u & 0xffff, dsp_api.db_r->d_burst_u & 0xffff, dsp_api.db_r->d_task_md & 0xffff, dsp_api.db_r->d_task_ra & 0xffff
end
document tasks
tasks — the tasks scheduled by the ARM (page W) and those the DSP returned (page R), with their names (FB, SB, PM, NBS, ALLC...).
end

define dbw
  p *dsp_api.db_w
end
document dbw
dbw — the full ARM->DSP write page (d_task_*, d_fn, d_ctrl_abb, a_a5fn, d_afc, d_ctrl_system...).
end

define dbr
  p *dsp_api.db_r
end
document dbr
dbr — the full DSP->ARM read page (returned tasks, a_serv_demod, a_pm, a_sch).
end

define sync
  printf "ndb  : d_fb_det=%u d_fb_mode=%u  a_sync_demod TOA=%d PM=%d ANGLE=%d SNR=%u\n", dsp_api.ndb->d_fb_det & 0xffff, dsp_api.ndb->d_fb_mode & 0xffff, (short)(dsp_api.ndb->a_sync_demod[0] & 0xffff), (short)(dsp_api.ndb->a_sync_demod[1] & 0xffff), (short)(dsp_api.ndb->a_sync_demod[2] & 0xffff), dsp_api.ndb->a_sync_demod[3] & 0xffff
  printf "db_r : a_serv_demod TOA=%d PM=%d(>>3=%d) ANGLE=%d SNR=%u\n", (short)(dsp_api.db_r->a_serv_demod[0] & 0xffff), (short)(dsp_api.db_r->a_serv_demod[1] & 0xffff), (short)(dsp_api.db_r->a_serv_demod[1] & 0xffff) >> 3, (short)(dsp_api.db_r->a_serv_demod[2] & 0xffff), dsp_api.db_r->a_serv_demod[3] & 0xffff
end
document sync
sync — sync results: d_fb_det + a_sync_demod (NDB, FB path) and a_serv_demod (page R, SB/NB path).
end

define sb
  set $s0 = dsp_api.db_r->a_sch[0] & 0xffff
  set $sbw = (dsp_api.db_r->a_sch[3] & 0xffff) | ((dsp_api.db_r->a_sch[4] & 0xffff) << 16)
  printf "a_sch = %04x %04x %04x %04x %04x   ", $s0, dsp_api.db_r->a_sch[1] & 0xffff, dsp_api.db_r->a_sch[2] & 0xffff, dsp_api.db_r->a_sch[3] & 0xffff, dsp_api.db_r->a_sch[4] & 0xffff
  if $s0 & (1 << $B_SCH_CRC)
    printf "CRC BAD (B_SCH_CRC)"
  else
    printf "CRC ok"
  end
  if $s0 & (1 << $B_BLUD)
    printf "  BLUD"
  end
  set $t1 = (($sbw >> 23) & 1) | (($sbw >> 7) & 0x1fe) | (($sbw << 9) & 0x600)
  set $t2 = ($sbw >> 18) & 0x1f
  set $t3p = (($sbw >> 24) & 1) | (($sbw >> 15) & 6)
  set $t3 = $t3p * 10 + 1
  printf "\nSB 0x%08x : BSIC=%u  t1=%u t2=%u t3=%u  (fn = 51*26*t1 + 51*((t3-t2+26)%%26) + t3 = %u)\n", $sbw, ($sbw >> 2) & 0x3f, $t1, $t2, $t3, 51*26*$t1 + 51*(($t3 - $t2 + 26) % 26) + $t3
end
document sb
sb — decodes a_sch like prim_fbsb.c: CRC, SB word, BSIC, t1/t2/t3 and fn.
end

define cd
  set $c0 = dsp_api.ndb->a_cd[0] & 0xffff
  printf "a_cd[0]=0x%04x", $c0
  if $c0 & (1 << $B_BLUD)
    printf " BLUD"
  end
  printf "  fire_crc=%u  biterr=%u\n", ($c0 & ((1 << $B_FIRE1) | (1 << $B_FIRE0))) >> $B_FIRE0, dsp_api.ndb->a_cd[2] & 0xffff
  printf "a_cd[1]=0x%04x  data[3..14] = ", dsp_api.ndb->a_cd[1] & 0xffff
  set $i = 3
  while $i < 15
    printf "%04x ", dsp_api.ndb->a_cd[$i] & 0xffff
    set $i = $i + 1
  end
  printf "\n"
end
document cd
cd — the decoded data block (a_cd: BLUD state, Fire CRC, bit errors, 23 bytes of the L2/SI block).
end

define pm
  printf "a_pm = %d %d %d   (dBm8: %d)\n", (short)(dsp_api.db_r->a_pm[0] & 0xffff), (short)(dsp_api.db_r->a_pm[1] & 0xffff), (short)(dsp_api.db_r->a_pm[2] & 0xffff), (short)(dsp_api.db_r->a_pm[0] & 0xffff) >> 3
end
document pm
pm — the 3 power measurements returned by the DSP (page R).
end

define ndb
  err
  sync
  printf "d_dsp_state=0x%04x  bg enable=0x%04x state=0x%04x abort=0x%04x  d_tch_mode=0x%04x  d_a5mode=0x%04x\n", dsp_api.ndb->d_dsp_state & 0xffff, dsp_api.ndb->d_background_enable & 0xffff, dsp_api.ndb->d_background_state & 0xffff, dsp_api.ndb->d_background_abort & 0xffff, dsp_api.ndb->d_tch_mode & 0xffff, dsp_api.ndb->d_a5mode & 0xffff
  printf "d_dsp_page=0x%04x  version=%04x/%04x  d_rach=0x%04x\n", dsp_api.ndb->d_dsp_page & 0xffff, dsp_api.ndb->d_version_number1 & 0xffff, dsp_api.ndb->d_version_number2 & 0xffff, dsp_api.ndb->d_rach & 0xffff
end
document ndb
ndb — the NDB cells that matter: error, sync, DSP state, background tasks, page, version, RACH.
end

define dsp
  pages
  tasks
  ndb
  sb
end
document dsp
dsp — mailbox overview: pages + tasks + ndb + sb. The command to type first.
end

define apiram
  x/$arg1hx ($API + 2*($arg0 - 0x800))
end
document apiram
apiram OFF N — N words of API memory seen from the ARM, starting at DSP word OFF (0xffd00000 = word 0x0800; e.g. apiram 0x800 32 = page 0; apiram 0x8f8 8 = d_fb_det...).
end

define apiw
  set *(unsigned short *)($API + 2*($arg0 - 0x800)) = $arg1
  printf "api[0x%04x] <- 0x%04x\n", $arg0, $arg1
end
document apiw
apiw OFF VAL — writes DSP word OFF (DSP-side address, e.g. 0x08f8) in the shared API memory.
end

define rxnb
  p rxnb
end
document rxnb
rxnb — normal burst reception state (rxnb: meas[4], current msg).
end

# =============================================================================
#  FORCING / FAKE RESULTS  (write into the mailbox: use with the target STOPPED)
# =============================================================================
define fake_fb
  set dsp_api.ndb->d_fb_det = 1
  set dsp_api.ndb->a_sync_demod[0] = $arg0
  set dsp_api.ndb->a_sync_demod[1] = $arg1
  set dsp_api.ndb->a_sync_demod[2] = $arg2
  set dsp_api.ndb->a_sync_demod[3] = $arg3
  printf "FB forced: d_fb_det=1 toa=%d pm=%d angle=%d snr=%d\n", $arg0, $arg1, $arg2, $arg3
  sync
end
document fake_fb
fake_fb TOA PM ANGLE SNR — makes the ARM believe the DSP detected an FB (e.g. fake_fb 48 5511 -2 200).
end

define fake_sb
  set $t1 = $arg1
  set $t2 = $arg2
  set $t3p = ($arg3 - 1) / 10
  set $w = (($arg0 & 0x3f) << 2) | (($t1 & 1) << 23) | (($t1 & 0x1fe) << 7) | (($t1 & 0x600) >> 9) | (($t2 & 0x1f) << 18) | (($t3p & 1) << 24) | (($t3p & 6) << 15)
  set dsp_api.db_r->a_sch[0] = 0
  set dsp_api.db_r->a_sch[3] = $w & 0xffff
  set dsp_api.db_r->a_sch[4] = ($w >> 16) & 0xffff
  printf "SB forced: 0x%08x  bsic=%u t1=%u t2=%u t3=%u\n", $w, $arg0, $t1, $t2, $arg3
  sb
end
document fake_sb
fake_sb BSIC T1 T2 T3 — builds a valid SB word (CRC ok) in a_sch so the ARM decodes this BSIC and this time (e.g. fake_sb 7 100 5 11).
end

define sb_force
  set dsp_api.db_r->a_sch[0] = dsp_api.db_r->a_sch[0] & ~(1 << $B_SCH_CRC)
  printf "B_SCH_CRC cleared: the ARM will decode a_sch[3..4] as is\n"
  sb
end
document sb_force
sb_force — clears the CRC bit of a_sch[0]: the ARM accepts the SB word present, even if the DSP flagged it bad.
end

define si_force
  set dsp_api.ndb->a_cd[0] = (1 << $B_BLUD)
  set dsp_api.ndb->a_cd[2] = 0
  printf "a_cd forced: BLUD, fire_crc=0, biterr=0 -> the ARM takes the present block as good\n"
  cd
end
document si_force
si_force — forces acceptance of the a_cd block present (BLUD + Fire CRC ok + 0 errors): the ARM passes this SI/block up to L2.
end

define fake_cd
  set dsp_api.ndb->a_cd[3] = $arg0
  set dsp_api.ndb->a_cd[4] = $arg1
  set dsp_api.ndb->a_cd[5] = $arg2
  set dsp_api.ndb->a_cd[6] = $arg3
  set dsp_api.ndb->a_cd[7] = $arg4
  set dsp_api.ndb->a_cd[8] = $arg5
  set dsp_api.ndb->a_cd[9] = $arg6
  set dsp_api.ndb->a_cd[10] = $arg7
  set dsp_api.ndb->a_cd[11] = $arg8
  set dsp_api.ndb->a_cd[12] = $arg9
  si_force
end
document fake_cd
fake_cd W3 W4 ... W12 — puts 10 data words in a_cd[3..12] then si_force (the last 2 words stay).
end

define fake_err
  set dsp_api.ndb->d_error_status = $arg0
  err
end
document fake_err
fake_err VAL — writes d_error_status (e.g. fake_err 0 to clear DMA_PROG).
end

define fake_task
  set dsp_api.db_w->d_task_d = $arg0
  printf "db_w->d_task_d <- %u\n", $arg0
  tasks
end
document fake_task
fake_task N — schedules DL task N in page W (5=FB 6=SB 1=PM 24=ALLC 19=NBS 21=NP 10=RACH).
end

define fake_page
  set dsp_api.ndb->d_dsp_page = $arg0
  pages
end
document fake_page
fake_page VAL — forces d_dsp_page (bit0 = DSP page W, bit1 = ...) to test page selection.
end

define abort_dsp
  set dsp_api.db_w->d_ctrl_system = dsp_api.db_w->d_ctrl_system | (1 << $B_TASK_ABORT)
  printf "B_TASK_ABORT set in d_ctrl_system (page W)\n"
end
document abort_dsp
abort_dsp — sets B_TASK_ABORT: asks the DSP to abort its current task (what l1s_dsp_abort does).
end

# =============================================================================
#  BREAKPOINTS / WATCH
# =============================================================================
define bfb
  break l1s_fbdet_resp
end
document bfb
bfb — stops at each FB detection response (l1s_fbdet_resp). Then: mon, sync, fn.
end

define bsb
  break l1s_sbdet_resp
end
document bsb
bsb — stops at each SB response (l1s_sbdet_resp). Then: sb, mon.
end

define bfbsb
  break l1s_fbsb_req
end
document bfbsb
bfbsb — stops when L1 receives an FBSB request from the mobile (l1s_fbsb_req).
end

define bsync
  break synchronize_tdma
end
document bsync
bsync — stops at the TDMA realignment (synchronize_tdma), right after an accepted FB/SB.
end

define bnb
  break l1s_nb_resp
end
document bnb
bnb — stops at each normal block received (l1s_nb_resp). Then: cd, rxnb.
end

define bpm
  break l1s_pm_resp
end
document bpm
bpm — stops at each power measurement returned (l1s_pm_resp). Then: pm.
end

define breset
  break l1s_reset
end
document breset
breset — stops at each L1 reset (l1s_reset): who resets L1 and when.
end

define bcompl
  break l1s_compl_sched
end
document bcompl
bcompl — stops at each scheduled completion (l1s_compl_sched): see compl.
end

define babort
  break l1s_dsp_abort
end
document babort
babort — stops when the ARM aborts the DSP task (l1s_dsp_abort).
end

define bframe
  break tdma_sched_execute
end
document bframe
bframe — stops at EVERY TDMA frame (tdma_sched_execute). Heavy: use with trace_frames.
end

define bl2
  break l1_queue_for_l2
end
document bl2
bl2 — stops when L1 passes a message up to L2 (SI, block, measurement).
end

define bafc
  break afc_input
end
document bafc
bafc — stops at each AFC input (afc_input freq_diff).
end

define wfb
  watch dsp_api.ndb->d_fb_det
end
document wfb
wfb — watchpoint on a WRITE of d_fb_det (ARM view; DSP writes do not go through the ARM bus, only the ARM's trigger it).
end

define werr
  watch dsp_api.ndb->d_error_status
end
document werr
werr — watchpoint on an ARM write of d_error_status.
end

define wtask
  watch dsp_api.db_w->d_task_d
end
document wtask
wtask — watchpoint on the ARM scheduling a DL task.
end

define bl
  info breakpoints
end
document bl
bl — list of breakpoints/watchpoints.
end

define bclr
  delete
  printf "all breakpoints deleted\n"
end
document bclr
bclr — deletes all breakpoints.
end

# =============================================================================
#  TRACE LOOPS  (target in the foreground: Ctrl-C interrupts the loop)
# =============================================================================
define trace_frames
  set $n = $arg0
  tbreak tdma_sched_execute
  continue
  while $n > 0
    fn
    tasks
    set $n = $n - 1
    if $n > 0
      tbreak tdma_sched_execute
      continue
    end
  end
  printf "-- %d frames traced, target STOPPED (go to resume)\n", $arg0
end
document trace_frames
trace_frames N — stops N frames in a row (tdma_sched_execute) and shows fn + tasks each time. Ctrl-C to cut. go afterwards.
end

define trace_fb
  set $n = $arg0
  while $n > 0
    tbreak l1s_fbdet_resp
    continue
    fn
    sync
    set $n = $n - 1
  end
  printf "-- %d FB responses traced, target STOPPED (go to resume)\n", $arg0
end
document trace_fb
trace_fb N — waits for N FB responses (l1s_fbdet_resp), shows fn + sync at each.
end

define trace_sb
  set $n = $arg0
  while $n > 0
    tbreak l1s_sbdet_resp
    continue
    fn
    sb
    set $n = $n - 1
  end
  printf "-- %d SB responses traced, target STOPPED (go to resume)\n", $arg0
end
document trace_sb
trace_sb N — waits for N SB responses (l1s_sbdet_resp), shows fn + a_sch decoding at each.
end

define trace_nb
  set $n = $arg0
  while $n > 0
    tbreak l1s_nb_resp
    continue
    fn
    cd
    set $n = $n - 1
  end
  printf "-- %d blocks traced, target STOPPED (go to resume)\n", $arg0
end
document trace_nb
trace_nb N — waits for N normal blocks (l1s_nb_resp), shows fn + a_cd at each.
end

define trace_l2
  set $n = $arg0
  while $n > 0
    tbreak l1_queue_for_l2
    continue
    fn
    printf "msg -> L2: "
    p *(struct msgb *)$r0
    set $n = $n - 1
  end
  printf "-- %d L2 messages traced, target STOPPED (go to resume)\n", $arg0
end
document trace_l2
trace_l2 N — waits for N messages passed up to L2 (l1_queue_for_l2) and shows them.
end

define mon_dsp
  set $n = $arg0
  while $n > 0
    tbreak tdma_sched_execute
    continue
    printf "==== frame %u ====\n", l1s.current_time.fn
    dsp
    set $n = $n - 1
  end
  printf "-- %d samples, target STOPPED (go to resume)\n", $arg0
end
document mon_dsp
mon_dsp N — N frames in a row, the full `dsp` view at each (pages, tasks, ndb, sb).
end

define every
  set $n = $arg0
  while $n > 0
    tbreak tdma_sched_execute
    continue
    $arg1
    set $n = $n - 1
  end
  printf "-- done, target STOPPED (go to resume)\n"
end
document every
every N CMD — runs the command CMD at each of the next N frames (e.g. every 20 sync).
end

# =============================================================================
#  HELP
# =============================================================================
define help_osmo
  printf "\n============ OSMOCOM PANEL (cmd.gdb) ============\n"
  printf "EXECUTION       go            resume without blocking (continue &)\n"
  printf "                stop          stops the ARM (= Ctrl-C)\n"
  printf "                regs / pcx / bt10 / si1 / ni1   registers, code at $pc, stack, single step\n"
  printf "                frame_step    runs until the next TDMA frame, then stops\n"
  printf "TIME            fn            current frame, next, tpu_offset\n"
  printf "                l1            L1 summary: time, cell, modes, TA, pages\n"
  printf "                cell / neigh / sched / mframe / compl / arfcn / afc\n"
  printf "SYNC            fbs / mon     FB/SB state seen by the ARM (fbs, fbs.mon)\n"
  printf "                sync          d_fb_det + a_sync_demod + a_serv_demod\n"
  printf "                sb            a_sch decoded: CRC, BSIC, t1/t2/t3, fn\n"
  printf "MAILBOX         dsp           ALL: pages + tasks + ndb + sb\n"
  printf "                pages / tasks / dbw / dbr / ndb / err / cd / pm / rxnb\n"
  printf "                apiram OFF N  raw API words (DSP-side address)      apiw OFF VAL  writes a word\n"
  printf "FORCING         fake_fb TOA PM ANGLE SNR   a detected FB\n"
  printf "                fake_sb BSIC T1 T2 T3      a valid SB              sb_force   clears the bad CRC\n"
  printf "                si_force                   accepts the a_cd block  fake_cd W3..W12  puts 10 words + si_force\n"
  printf "                fake_err V / fake_task N / fake_page V / abort_dsp\n"
  printf "BREAKPOINTS     bfb bsb bfbsb bsync bnb bpm breset bcompl babort bframe bl2 bafc\n"
  printf "                wfb werr wtask (watch)      bl list      bclr delete all\n"
  printf "LOOPS           trace_frames N / trace_fb N / trace_sb N / trace_nb N / trace_l2 N\n"
  printf "                mon_dsp N     the dsp view at each frame, N times\n"
  printf "                every N CMD   CMD at each frame, N times (e.g. every 20 sync)\n"
  printf "                Ctrl-C cuts a loop; the target stays STOPPED: go to resume.\n"
  printf "DEMO            demo          hands on the firmware: stop, state, one frame, printf, resume\n"
  printf "                demo etat | trame | hello | go      the steps one by one\n"
  printf "HELP            help_osmo     this      help CMD   details of a command\n"
  printf "Rule: reads (fn, dsp...) need the target STOPPED (stop); go afterwards.\n\n"
end
document help_osmo
help_osmo — lists all the commands of the osmocom panel, with their role and usage.
end

printf "[cmd.gdb] osmocom panel loaded: help_osmo\n"
python
import gdb, os
for _d in (os.environ.get("OSMO_GDB_TOOLS", ""), "/opt/GSM/qosmo/tools", "/opt/GSM/qosmo/tools"):
    _f = os.path.join(_d, "demo-layer1.py") if _d else ""
    if _f and os.path.isfile(_f):
        gdb.execute("source " + _f)
        break
else:
    gdb.write("[cmd.gdb] demo-layer1.py not found (OSMO_GDB_TOOLS=%r): no demo command\n"
              % os.environ.get("OSMO_GDB_TOOLS", ""))
end
